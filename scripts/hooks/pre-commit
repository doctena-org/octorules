#!/usr/bin/env bash
# Pre-commit hook: lint + format check + CDN ranges staleness check.
#
# Install: from the repo root, run:
#   ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
set -euo pipefail

.venv/bin/pip install -e ".[dev]" -q
.venv/bin/ruff check octorules/ tests/
.venv/bin/ruff format --check octorules/ tests/
.venv/bin/python scripts/sync_cdn_ranges.py --check
